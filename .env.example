# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://crm:crm_secret@localhost:5432/crm_dev?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ─── Client Branding (per deployment) ───────────────────
APP_NAME=CRM Platform
APP_LOGO_URL=
PRIMARY_COLOR=#18181B
ENABLED_MODULES=leads,customers,deals,tasks,reports,settings

# ─── Seed ───────────────────────────────────────────────
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=Admin123!

# ─── Email (Week 5) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── File Storage (Week 4) ────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
